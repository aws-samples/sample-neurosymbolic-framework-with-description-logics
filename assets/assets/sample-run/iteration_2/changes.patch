+    use_due_to = parsed.get("use_due_to", False)
+    search_terms = parsed.get("search_terms", [])
+
+    concept_id = find_concept(conn, concept_name) if concept_name else None
+
+    # Get candidate set
+    candidates = None
+
+    if concept_id:
